# Cloud Chat Completions API; use a model with function calling support.
# 云端配置：填写模型 ID 或推理接入点 ID，不要填写完整 /chat/completions 路径。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your-api-key
MODEL=your-model-or-endpoint-id

# Optional cloud embeddings; independent from the conversation model.
# 可选云端向量：使用时取消下面三行注释，并填写百炼对应地域的配置。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_MODEL=text-embedding-v4
# 兼容已有变量名 EMBEDDDING_MODEL；新配置请使用 EMBEDDING_MODEL。
